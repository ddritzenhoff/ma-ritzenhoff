@inproceedings{10.1007/978-981-97-0798-0_6,
author = {Huang, Tianyi and Zhao, Shizhen},
title = {Accelerating QUIC with AF\_XDP},
year = {2024},
isbn = {978-981-97-0797-3},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-97-0798-0_6},
doi = {10.1007/978-981-97-0798-0_6},
abstract = {QUIC is a high-performance and secure transport layer protocol that has been applied in many scenarios. Considering that kernel bypass techniques can avoid the overhead of the kernel’s network stack and therefore improve the performance greatly, we choose AF\_XDP, a compatible kernel bypass technique to improve the performance of QUIC. We present XSKConn, a Golang package that implements UDP connection based on AF\_XDP and we integrate it into quic-go. The experiments show that XSKConn improves the RPS of quic-go by 5\% to 40\%, while the CPU usage also decreases by 5\% to 50\%.},
booktitle = {Algorithms and Architectures for Parallel Processing: 23rd International Conference, ICA3PP 2023, Tianjin, China, October 20–22, 2023, Proceedings, Part III},
pages = {89–100},
numpages = {12},
keywords = {network system, eBPF, QUIC, kernel bypass},
location = {Tianjin, China}
}

